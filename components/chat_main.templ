package components

templ ChatHome(user string){


<div class="flex flex-col h-screen w-full p-20 justify-center transition duration-500">
    <div class="m-4">
        <h1 class=" text-xl font-light">Hi, {user}</h1>
        <h1 class=" text-3xl font-large">Where should we start?</h1>
    </div>
    <div class="relative">
        <textarea autofocus
            class="w-full min-h-[80px] max-h-[200px] p-5  rounded-2xl bg-slate-900 text-white text-sm font-sans outline-none resize-none"
            name="input" id="input" placeholder="Ask Nexus"></textarea>
        <div
            class="absolute bottom-1 mr-2 mb-2 right-0 hover:bg-slate-800 w-[30px] h-[30px] rounded-full transition duration-300">
            <h1 class="text-center text-md text-gray-300 font-light">+</h1>
        </div>
    </div>
</div>

}