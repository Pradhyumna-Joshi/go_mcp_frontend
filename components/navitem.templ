package components

import "github.com/Pradhyumna-Joshi/go_mcp_frontend/models"

templ NavItem(input models.NavItem){
<div hx-get={input.GetURL} hx-target={input.Target} hx-swap={input.Swap }
    class="flex flex-row gap-2 items-center w-full p-2 mb-1 rounded-md shadow-md  hover:bg-slate-900 transition duration-300 ease-in-out cursor-pointer">
    <i class={input.IconClass}></i>
    <h3 class="select-none text-base">{input.Title}</h3>
</div>
}